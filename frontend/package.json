{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:constellations": "vite --config vite.constellations.config.ts",
    "build": "tsc -b && vite build",
    "build:constellations": "tsc -b && vite build --config vite.constellations.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:constellations": "vite preview --config vite.constellations.config.ts",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "dependencies": {
    "plotly.js-dist-min": "^2.35.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^26.6.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
